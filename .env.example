# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL=postgres://analyst:analyst@localhost:5432/analyst

# Alpaca (free plan: IEX data + Benzinga news). Paper account keys.
ALPACA_KEY_ID=
ALPACA_SECRET=

# SEC EDGAR fair access requires a declared User-Agent: "AppName contact@example.com"
SEC_USER_AGENT=

# Alpaca's free plan allows one news websocket per account. Set to false on any copy of the
# worker that shouldn't hold it (e.g. locally once Railway runs).
NEWS_STREAM_ENABLED=true

# Alpha Vantage (earnings calendar). Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Email. On Railway use Resend (HTTPS): Railway's Hobby plan blocks outbound SMTP ports.
# Without a verified domain Resend only sends from onboarding@resend.dev to your own signup email.
RESEND_API_KEY=
# RESEND_FROM=AI Investment Analyst <onboarding@resend.dev>

# Gmail via nodemailer: used only when RESEND_API_KEY is empty (fine locally).
# Use an app password, not your account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=

# Twelve Data (pullback screen fallback quotes when Alpaca has no price). Free key:
# https://twelvedata.com/ (8 requests/minute, 800/day).
TWELVEDATA_API_KEY=

# Read-only pullback export for external research agents: GET /pullbacks.json and /pullbacks.csv
# with "Authorization: Bearer <token>". The HTTP server only starts when this is set.
# Generate one with: openssl rand -hex 24. Railway sets PORT.
PULLBACK_EXPORT_TOKEN=
