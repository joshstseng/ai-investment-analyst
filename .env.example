# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL=postgres://analyst:analyst@localhost:5432/analyst

# Alpaca (free plan: IEX data + Benzinga news). Paper account keys.
ALPACA_KEY_ID=
ALPACA_SECRET=

# SEC EDGAR fair access requires a declared User-Agent: "AppName contact@example.com"
SEC_USER_AGENT=

# Alpaca's free plan allows one news websocket per account. Set to false on any copy of the
# worker that shouldn't hold it (e.g. locally once Railway runs).
NEWS_STREAM_ENABLED=true

# Gmail via nodemailer (use an app password, not your account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
